# ---------------------------------------------------------------------------
# DRAFTox backend — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Master ordering switch (SERVER-side only). Set to `true` ONLY when the shop
# is actually open for new orders. When unset or `false`, new order creation
# and online payment initiation are rejected with 503 ORDERS_DISABLED — the
# browser can never turn this on. Existing orders/shipments/admin stay live.
# STORE_ORDERS_ENABLED=false

# DEV-ONLY test price override. When `true` AND NODE_ENV is NOT `production`,
# the 16-channel system is priced at a token amount (currently ₹10) everywhere
# the server computes a price (order creation, product serialization) so the
# full order/payment flow can be exercised with real Razorpay test keys without
# charging the real ₹7,999. It is IMPOSSIBLE to enable in production (the
# NODE_ENV guard wins even if this is set) and every other product is unchanged.
# The storefront needs its matching NEXT_PUBLIC_DEV_TEST_PRICE_ENABLED=true to
# show the same price; leave BOTH off in every real environment.
# DEV_TEST_PRICE_ENABLED=false
#
# DEV-ONLY free-shipping override. When `true` AND NODE_ENV is NOT `production`,
# the server charges ₹0 delivery for every order, so the token-priced system's
# complete payable total is exactly ₹10 (₹10 price + ₹0 delivery). Pair it with
# the storefront's NEXT_PUBLIC_DEV_FREE_SHIPPING_ENABLED=true so the shown total
# matches. Impossible to enable in production (NODE_ENV guard wins even if set)
# and irrelevant otherwise (normal orders keep the ₹110 / free-over-₹10,000 rule).
# DEV_FREE_SHIPPING_ENABLED=false

# PostgreSQL connection (development database)
# Create the database first, e.g.: CREATE DATABASE draftox_backend;
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/draftox_backend?schema=public
#
# PRODUCTION: use a least-privilege application role (NOT a PostgreSQL superuser)
# and require TLS for any remote or managed database. Append to the URL:
#   &sslmode=require          (encrypt the connection; required for remote DBs)
#   &sslmode=verify-full      (also verify the server certificate, where supported)
# Optionally cap the connection pool for scaled/limited plans:
#   &connection_limit=5&pool_timeout=20
# A production URL with no sslmode may talk to a remote database in plaintext.

# Optional Redis. When REDIS_URL is set, Redis powers TWO features:
#   1. A short-TTL cache for PUBLIC catalogue reads only (list + slug lookups).
#   2. A SHARED rate-limit store, so limits hold across multiple API instances
#      (keys are namespaced per limiter: ratelimit:<scope>:<ip>).
# Never a hard dependency: when unset or unreachable, reads fall back to
# PostgreSQL, the cache is skipped, and rate limiting falls back to a
# per-process in-memory store (single-instance only). The API never fails
# because Redis is unavailable. Use a dedicated, least-privilege Redis and
# never expose it publicly.
#
# Connection string (leave unset to disable BOTH the cache and shared limits):
# REDIS_URL=redis://:PASSWORD@localhost:6379
# Cache TTL for catalogue reads, in seconds (default 60):
# CACHE_TTL_SECONDS=60

# Optional: dedicated database used by the test suite (vitest).
# If unset, tests derive it from DATABASE_URL by appending _test to the database name.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/draftox_backend_test?schema=public

# Frontend + CORS — the actual Next.js origin(s), comma separated. No wildcards with credentials.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional cookie Domain for the CSRF cookie ONLY. Leave UNSET for local
# development and any single-host setup (the cookie stays host-only). Set it only
# when the storefront and API are on sibling subdomains: the non-HttpOnly
# double-submit CSRF cookie must be readable by the frontend JS, so it has to be
# shared across the domain. Accepts ONLY a bare domain with a leading dot — no
# scheme, path, port, or whitespace, e.g.:
#   COOKIE_DOMAIN=.draftox.in
# The HttpOnly session / Firebase-session / OAuth-state cookies are NEVER
# affected by this value; they remain host-only.
# COOKIE_DOMAIN=

# Session security — minimum 32 characters, random
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime in hours (default 7 days)
SESSION_TTL_HOURS=168

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must equal GOOGLE_CALLBACK_URL exactly, e.g.:
#   GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Leave ALL THREE blank to disable the Google sign-in endpoints.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Firebase Authentication (Admin SDK) — SERVER-side only. Never expose these to
# the frontend and never commit a real service account.
#
# Web App vs Admin: the PUBLIC web-app config (NEXT_PUBLIC_FIREBASE_*) lives
# ONLY in the storefront .env.local (see the frontend .env.example). These
# Admin credentials must come from the SAME Firebase project so the ID token
# the browser mints can be verified here. Service account location:
#   Firebase Console -> Project settings -> Service accounts -> Generate new
#   private key.
#
# Provide EITHER the whole service-account JSON (recommended on hosts that allow
# multi-line values) OR the three discrete values, never both:
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}
#   FIREBASE_PROJECT_ID=your-project-id
#   FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Session cookies issued by the Admin SDK are capped at 14 days; default 5.
# Leave Firebase blank to keep the pre-existing session path as the boundary
# while the migration is staged. The frontend pairs with NEXT_PUBLIC_FIREBASE_*.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SESSION_TTL_DAYS=5
#
# Local development against the Firebase Auth emulator (never in production):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------------
# Administrator authorization — an EXPLICIT allow-list, server-side only.
#
#   ADMIN_EMAIL  = draftox0@gmail.com (DEFAULT) — the primary administrator.
#   ADMIN_EMAILS = extra administrator emails, comma-separated.
#
# The authorized set is the UNION of ADMIN_EMAIL and ADMIN_EMAILS. Matching is
# EXACT (case-insensitive): listing one address never authorizes other accounts
# on the same domain (there is no domain/prefix wildcard). EVERY administrator
# also requires a Google/Firebase-VERIFIED email — an unverified email, a
# client-supplied role, or a client-supplied `admin` claim is always denied.
# The decision is enforced server-side; the frontend only mirrors it.
#
# The two official DRAFTOX accounts (both verified) are administrators:
#   ADMIN_EMAILS=draftox0@gmail.com,draftoxcustomersupport@gmail.com
#
# SUPPORT_EMAIL / SMTP_USER = draftoxcustomersupport@gmail.com is ALSO the
# customer-facing support inbox and the shipment-email SENDER. It is an
# authorized admin AND remains the support contact — the authorization list and
# the sender identity are configured separately and must both stay explicit.
# ---------------------------------------------------------------------------
# Primary administrator (server-side config; not a Google OAuth client setting).
# Leave blank to use the built-in default draftox0@gmail.com.
# ADMIN_EMAIL=draftox0@gmail.com
# Additional administrators (comma-separated). Leave blank for single-admin.
# ADMIN_EMAILS=draftox0@gmail.com,draftoxcustomersupport@gmail.com

# Razorpay online payments (https://dashboard.razorpay.com/app/keys)
# Leave ALL THREE blank to disable online payments: the payments endpoints
# answer 503 and the storefront shows an integration-pending state.
# Secrets stay server-side — only KEY_ID is ever sent to the browser.
# Key ID format reveals the mode: rzp_test_... = TEST, rzp_live_... = LIVE.
# Use TEST keys in development and switch to LIVE keys (plus a signed webhook
# secret) only when you are ready to accept real payments. The server warns at
# startup if the key mode and NODE_ENV disagree or if the webhook secret is
# missing (webhooks return 503 until it is set).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to register in the dashboard:
#   https://<api-host>/api/v1/payments/razorpay/webhook
# Use the webhook verification secret offered by the Razorpay Dashboard.

# Delhivery courier integration — PLACEHOLDERS ONLY.
# Live booking is NOT implemented: shipment/tracking details are recorded
# manually by an admin. Leave these blank until onboarding is complete.
# DELHIVERY_MODE=staging          # staging (default) | production
# DELHIVERY_API_TOKEN=            # per-environment token from Delhivery
# DELHIVERY_BASE_URL=             # defaults to the staging/production base
# DELHIVERY_PICKUP_LOCATION=      # registered pickup warehouse/location name
# DELHIVERY_ENABLE_BOOKING=false  # must be true (with credentials) to book

# Email delivery — used for BOTH password resets AND customer shipment /
# tracking emails. While this is `none`, admins can save shipments, but no
# email is ever sent: the API truthfully reports the delivery status
# (NOT_CONFIGURED) and the admin UI offers a retry once it is configured.
#
# To actually deliver email, set provider=smtp and provide SMTP credentials.
# SMTP_USER is the SENDER = the support account (draftoxcustomersupport@gmail.com);
# it is unrelated to ADMIN_EMAIL and is itself a regular customer account.
# Gmail example (use an App Password, not your account password, and never
# commit these values):
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=draftoxcustomersupport@gmail.com
#   SMTP_PASS=<16-character Google App Password>
#   EMAIL_FROM=DRAFTox <draftoxcustomersupport@gmail.com>
# Gmail requires From to match the authenticated SMTP_USER, so either set
# EMAIL_FROM to the same address or leave it unset (falls back to SMTP_USER).
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM=DRAFTox <draftoxcustomersupport@gmail.com>
#
# RECOMMENDED (production): Brevo transactional email over HTTPS. Outbound SMTP
# is blocked on many hosts (Render Free blocks ports 25/465/587), so the SMTP
# path above can silently fail in production. When BREVO_API_KEY is set, ALL
# outbound mail (contact notifications, shipment/tracking, password resets,
# order emails) is delivered via https://api.brevo.com/v3/smtp/email instead —
# no SMTP ports are used. Brevo takes precedence when both paths are configured.
# The API key is server-side ONLY: never log it, commit it, or expose it to the
# browser. Create it in Brevo > SMTP & API > API Keys. The sender address below
# must be a verified sender in your Brevo account.
#   BREVO_API_KEY=<brevo transactional API key>
#   EMAIL_FROM=harshvishwa10@gmail.com
#   EMAIL_FROM_NAME=DRAFTOX
#   OWNER_NOTIFICATION_EMAIL=draftoxcustomersupport@gmail.com
# A successful send returns 201 with a messageId, which means Brevo ACCEPTED
# and QUEUED the message — not that it reached the recipient's inbox.
# BREVO_API_KEY=
# EMAIL_FROM_NAME=DRAFTOX
# OWNER_NOTIFICATION_EMAIL=draftoxcustomersupport@gmail.com
#
# Hard upper bound (ms) on ANY single send attempt (connect + greeting +
# socket + final race). Default 8000, max 12000. It MUST stay below the
# storefront client's 15s request abort: hosts that block outbound SMTP
# (e.g. Render Free blocks ports 25/465/587) would otherwise hold the
# contact/support/order HTTP request open for minutes and the browser would
# abort with a bogus "Could not reach the server" even though the record was
# already saved. On timeout the send is recorded as FAILED (retryable) and the
# saved record is never undone.
# EMAIL_SEND_TIMEOUT_MS=8000

# Support address shown in the footer of customer emails + on the tracking
# page, so recipients know where to reach a human. This is the SUPPORT account
# and shipment SENDER — a regular customer account, NOT the admin. Defaults to
# draftoxcustomersupport@gmail.com.
# SUPPORT_EMAIL=draftoxcustomersupport@gmail.com

# Public site origin used to build customer-facing tracking links
# (https://draftox.in/track/<token>). In production, set this to your real
# domain — customers click this link from their shipment email and MUST reach
# a working page. Falls back to FRONTEND_URL when unset.
PUBLIC_SITE_URL=https://draftox.in

# Rate limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# INQUIRY_RATE_LIMIT_WINDOW_MS=3600000
# INQUIRY_RATE_LIMIT_MAX=10

# Public tracking page rate limit (login-free endpoint)
# TRACKING_RATE_LIMIT_WINDOW_MS=900000
# TRACKING_RATE_LIMIT_MAX=60
