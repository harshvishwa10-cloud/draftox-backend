# Render (and other hosts) set NODE_ENV=production, which makes npm default to
# omitting devDependencies. The TypeScript build needs devDependencies
# (typescript + @types/*), so force them in for every install.
# Note: @prisma/client pulls in prisma/typescript transitively, which is why a
# bare `npm ci` fails with TS7016/TS7006 instead of "tsc: not found".
include=dev
